<div class="jd-pool">
  <p class="jd-dialog__lede">{{localize "JD.Visit.dialogLede"}}</p>
  <div class="jd-pool__dice">
    <label class="jd-choice is-fixed">
      <input type="checkbox" checked disabled>
      <span class="jd-die jd-die--light" data-face="5"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
      <span class="jd-choice__text">
        <strong>{{localize "JD.Visit.pool.light"}}</strong>
        <em>{{localize "JD.Visit.pool.lightHint"}}</em>
      </span>
    </label>

    <label class="jd-choice">
      <input type="checkbox" name="helps">
      <span class="jd-die jd-die--scholar" data-face="5"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
      <span class="jd-choice__text">
        <strong>{{localize "JD.Visit.pool.helps"}}</strong>
        <em>{{#if occupation}}{{occupation}}{{else}}{{localize "JD.Sheet.occupation"}}{{/if}} · {{#if interest}}{{interest}}{{else}}{{localize "JD.Sheet.interest"}}{{/if}}</em>
      </span>
    </label>

    <label class="jd-choice jd-choice--meddle">
      <input type="checkbox" name="struck">
      <i class="fa-solid fa-hand-fist jd-choice__icon"></i>
      <span class="jd-choice__text">
        <strong>{{localize "JD.Visit.pool.struck"}}</strong>
        <em>{{localize "JD.Visit.pool.struckHint"}}</em>
      </span>
    </label>
  </div>
</div>
