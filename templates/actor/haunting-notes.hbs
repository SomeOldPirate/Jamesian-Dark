<section class="tab jd-tab {{tab.cssClass}}" data-group="primary" data-tab="notes">
  <div class="jd-prose">
    {{formInput fields.notes value=system.notes enriched=enrichedNotes toggled=true editable=editable name="system.notes"}}
  </div>
  <section class="jd-panel jd-principles">
    <header class="jd-panel__head"><h3>{{localize "JD.Principles.heading"}}</h3></header>
    <ul>
      <li><strong>{{localize "JD.Principles.slow.label"}}</strong> {{localize "JD.Principles.slow.text"}}</li>
      <li><strong>{{localize "JD.Principles.reticent.label"}}</strong> {{localize "JD.Principles.reticent.text"}}</li>
      <li><strong>{{localize "JD.Principles.comfort.label"}}</strong> {{localize "JD.Principles.comfort.text"}}</li>
      <li><strong>{{localize "JD.Principles.bargain.label"}}</strong> {{localize "JD.Principles.bargain.text"}}</li>
      <li><strong>{{localize "JD.Principles.clues.label"}}</strong> {{localize "JD.Principles.clues.text"}}</li>
    </ul>
  </section>
</section>
